<Window
  x:Class="ArSclStudio.Desktop.Views.MainWindow"
  x:DataType="vm:MainWindowViewModel"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ArSclStudio.Desktop.ViewModels"
  xmlns:nav="using:ArSclStudio.Engine.Navigation"
  xmlns:search="using:ArSclStudio.Engine.Search"
  Title="{Binding WindowTitle}"
  Width="1500"
  Height="920"
  MinWidth="1100"
  MinHeight="700">

  <Grid RowDefinitions="Auto,Auto,Auto,*,210,Auto">
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_Open SCL..." Click="OpenFileClick" IsEnabled="{Binding CanOpen}" />
        <MenuItem Header="_Save" Click="SaveClick" IsEnabled="{Binding CanSave}" />
        <MenuItem Header="Save _As..." Click="SaveAsClick" IsEnabled="{Binding CanSave}" />
        <Separator />
        <MenuItem Header="E_xit" Click="ExitClick" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Click="UndoClick" IsEnabled="{Binding CanUndo}" />
        <MenuItem Header="_Redo" Click="RedoClick" IsEnabled="{Binding CanRedo}" />
      </MenuItem>
      <MenuItem Header="_View" />
      <MenuItem Header="_SCL" />
      <MenuItem Header="_Tools" />
      <MenuItem Header="_Window" />
      <MenuItem Header="_Help" />
    </Menu>

    <Border
      Grid.Row="1"
      BorderBrush="{DynamicResource ThemeBorderLowBrush}"
      BorderThickness="0,0,0,1"
      Padding="8,6">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,180,Auto">
        <Button
          Classes="compact"
          Grid.Column="0"
          Content="Open"
          Click="OpenFileClick" />
        <Button
          Classes="compact"
          Grid.Column="1"
          Content="Save"
          Click="SaveClick"
          IsEnabled="{Binding CanSave}"
          Margin="6,0,0,0" />
        <Button
          Classes="compact"
          Grid.Column="2"
          Content="Merge SCL..."
          IsEnabled="False"
          Margin="14,0,0,0" />
        <Button
          Classes="compact"
          Grid.Column="3"
          Content="Add IED..."
          IsEnabled="False"
          Margin="6,0,0,0" />
        <Button
          Classes="compact"
          Grid.Column="4"
          Content="Extract IED..."
          IsEnabled="False"
          Margin="6,0,0,0" />

        <StackPanel
          Grid.Column="6"
          Orientation="Horizontal"
          VerticalAlignment="Center"
          Spacing="8">
          <TextBlock Text="Validation" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ProblemSummary}" Opacity="0.72" />
        </StackPanel>

        <ComboBox
          Grid.Column="7"
          Margin="12,0"
          ItemsSource="{Binding TargetProfiles}"
          SelectedItem="{Binding TargetProfile}" />

        <Button
          Classes="compact"
          Grid.Column="8"
          Content="Export..."
          IsEnabled="False" />
      </Grid>
    </Border>

    <Border
      Grid.Row="2"
      Background="{DynamicResource ThemeControlLowBrush}"
      Padding="10,5">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock
          Text="{Binding DocumentDisplayName}"
          FontWeight="SemiBold" />
        <StackPanel
          Grid.Column="1"
          Orientation="Horizontal"
          Spacing="12">
          <TextBlock Text="{Binding DocumentKind}" />
          <TextBlock Text="{Binding DocumentRevision}" Opacity="0.7" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid
      Grid.Row="3"
      ColumnDefinitions="330,5,*,5,330"
      Margin="8,8,8,0">

      <Border Grid.Column="0" Classes="panel">
        <Grid RowDefinitions="Auto,*">
          <TextBox
            Grid.Row="0"
            PlaceholderText="Search IEC object... (Ctrl+F)"
            TextChanged="SearchTextChanged"
            Margin="8" />

          <TabControl Grid.Row="1">
            <TabItem Header="{Binding IedWorkspaceHeader}">
              <ListBox
                ItemsSource="{Binding IedWorkspaceRows}"
                SelectedItem="{Binding SelectedIedWorkspace, Mode=TwoWay}"
                BorderThickness="0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="nav:SclIedWorkspaceProjection">
                    <Grid RowDefinitions="Auto,Auto,Auto" Margin="8,6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                          Text="{Binding Name}"
                          FontWeight="SemiBold"
                          TextTrimming="CharacterEllipsis" />
                        <TextBlock
                          Grid.Column="1"
                          Text="{Binding Manufacturer}"
                          Opacity="0.62"
                          Margin="8,0,0,0"
                          TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <TextBlock
                        Grid.Row="1"
                        Text="{Binding Description}"
                        Opacity="0.68"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,2,0,0" />
                      <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="0,4,0,0">
                        <TextBlock Text="{Binding LogicalDeviceCount, StringFormat='LD {0}'}" Opacity="0.62" />
                        <TextBlock Text="{Binding DataSetCount, StringFormat='DS {0}'}" Opacity="0.62" />
                        <TextBlock Text="{Binding ReportCount, StringFormat='RPT {0}'}" Opacity="0.62" />
                        <TextBlock Text="{Binding GooseCount, StringFormat='GOOSE {0}'}" Opacity="0.62" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>

            <TabItem Header="Model Tree">
              <ListBox
                ItemsSource="{Binding EngineeringRows}"
                SelectedItem="{Binding SelectedEngineeringRow, Mode=TwoWay}"
                BorderThickness="0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ExplorerRow">
                    <Grid
                      ColumnDefinitions="24,*,Auto"
                      Height="27"
                      Margin="{Binding IndentMargin}">
                      <Button
                        Grid.Column="0"
                        Content="{Binding Glyph}"
                        Width="22"
                        Height="22"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Focusable="False"
                        Click="EngineeringToggleClick" />
                      <TextBlock
                        Grid.Column="1"
                        Text="{Binding Name}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                      <TextBlock
                        Grid.Column="2"
                        Text="{Binding Badge}"
                        VerticalAlignment="Center"
                        Opacity="0.58"
                        Margin="8,0,6,0"
                        TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>

            <TabItem Header="XML">
              <ListBox
                ItemsSource="{Binding XmlRows}"
                SelectedItem="{Binding SelectedXmlRow, Mode=TwoWay}"
                BorderThickness="0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ExplorerRow">
                    <Grid
                      ColumnDefinitions="24,*,Auto"
                      Height="27"
                      Margin="{Binding IndentMargin}">
                      <Button
                        Grid.Column="0"
                        Content="{Binding Glyph}"
                        Width="22"
                        Height="22"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Focusable="False"
                        Click="XmlToggleClick" />
                      <TextBlock
                        Grid.Column="1"
                        Text="{Binding Name}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                      <TextBlock
                        Grid.Column="2"
                        Text="{Binding Badge}"
                        VerticalAlignment="Center"
                        Opacity="0.58"
                        Margin="8,0,6,0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>

      <GridSplitter
        Grid.Column="1"
        Width="5"
        ResizeDirection="Columns" />

      <Border Grid.Column="2" Classes="panel">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border
            Grid.Row="0"
            Padding="12,8"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock
                  Text="{Binding SelectedIedWorkspace.Name}"
                  FontSize="17"
                  FontWeight="SemiBold" />
                <TextBlock
                  Text="{Binding SelectedIedWorkspace.Manufacturer}"
                  Opacity="0.62"
                  VerticalAlignment="Center" />
                <TextBlock
                  Text="{Binding SelectedIedWorkspace.Description}"
                  Opacity="0.62"
                  VerticalAlignment="Center"
                  TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button
                Grid.Column="1"
                Content="Edit description"
                Click="EditDescriptionClick"
                IsEnabled="{Binding CanEdit}"
                Classes="compact" />
            </Grid>
          </Border>

          <TabControl
            Grid.Row="1"
            SelectedIndex="{Binding SelectedEngineeringWorkspaceIndex, Mode=TwoWay}">
            <TabItem Header="Overview">
              <ScrollViewer>
                <StackPanel Margin="12" Spacing="12">
                  <Grid ColumnDefinitions="150,*,150,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Text="IED" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedIedWorkspace.Name}" />
                    <TextBlock Grid.Column="2" Text="Manufacturer" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="{Binding SelectedIedWorkspace.Manufacturer}" />

                    <TextBlock Grid.Row="1" Text="Access Points" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding SelectedIedWorkspace.AccessPointCount}"
                               Margin="0,8,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="Logical Devices" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="3"
                               Text="{Binding SelectedIedWorkspace.LogicalDeviceCount}"
                               Margin="0,8,0,0" />

                    <TextBlock Grid.Row="2" Text="Logical Nodes" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding SelectedIedWorkspace.LogicalNodeCount}"
                               Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               Text="DataSets" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="3"
                               Text="{Binding SelectedIedWorkspace.DataSetCount}"
                               Margin="0,8,0,0" />

                    <TextBlock Grid.Row="3" Text="Reports / Logs" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding SelectedIedWorkspace.ReportCount}"
                               Margin="0,8,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="2"
                               Text="GOOSE / Setting Groups"
                               Margin="0,8,0,0" />
                    <StackPanel Grid.Row="3" Grid.Column="3"
                                Orientation="Horizontal" Spacing="12"
                                Margin="0,8,0,0">
                      <TextBlock Text="{Binding SelectedIedWorkspace.GooseCount, StringFormat='GOOSE {0}'}" />
                      <TextBlock Text="{Binding SelectedIedWorkspace.SettingGroupCount, StringFormat='SG {0}'}" />
                    </StackPanel>

                    <TextBlock Grid.Row="4"
                               Text="Sampled Values"
                               Margin="0,8,0,0" />
                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Text="{Binding SelectedIedWorkspace.SampledValueCount}"
                               Margin="0,8,0,0" />
                    <TextBlock Grid.Row="4"
                               Grid.Column="2"
                               Text="Declared Services"
                               Margin="0,8,0,0" />
                    <TextBlock Grid.Row="4"
                               Grid.Column="3"
                               Text="{Binding SelectedIedWorkspace.ServiceCapabilityCount}"
                               Margin="0,8,0,0" />
                  </Grid>

                  <Grid RowDefinitions="28,*"
                        MaxHeight="165">
                    <Grid
                      Background="{DynamicResource ThemeControlLowBrush}"
                      ColumnDefinitions="150,*,65">
                      <TextBlock Text="Declared service"
                                 Margin="6,5"
                                 FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1"
                                 Text="Parameters"
                                 Margin="6,5"
                                 FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2"
                                 Text="Nested"
                                 Margin="6,5"
                                 FontWeight="SemiBold" />
                    </Grid>
                    <ListBox
                      Grid.Row="1"
                      ItemsSource="{Binding ServiceCapabilityRows}"
                      SelectedItem="{Binding SelectedServiceCapability, Mode=TwoWay}"
                      BorderThickness="0">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="nav:SclServiceCapabilityProjection">
                          <Grid ColumnDefinitions="150,*,65"
                                Height="27">
                            <TextBlock Text="{Binding Name}"
                                       Margin="6,4"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Parameters}"
                                       Margin="6,4"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding NestedElementCount}"
                                       Margin="6,4"
                                       HorizontalAlignment="Right" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>

                  <Border
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,10,0,0">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Selected object" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding DetailTitle}" />
                      <TextBlock Text="{Binding DetailDescription}"
                                 Opacity="0.68" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding DetailPath}"
                                 Opacity="0.52" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <StackPanel Spacing="6" IsVisible="{Binding IsEditing}">
                    <TextBlock Text="IED description" FontWeight="SemiBold" />
                    <TextBox Text="{Binding DescriptionDraft, Mode=TwoWay}"
                             MaxLength="4096"
                             AcceptsReturn="True"
                             MinHeight="60"
                             MaxHeight="120"
                             TextWrapping="Wrap" />
                    <CheckBox Content="Remove description attribute"
                              IsChecked="{Binding RemoveDescription, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Content="Apply"
                              Click="ApplyDescriptionClick"
                              IsEnabled="{Binding CanApply}" />
                      <Button Content="Cancel"
                              Click="CancelDescriptionClick"
                              IsEnabled="{Binding CanApply}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Network">
              <Grid RowDefinitions="29,*">
                <Grid
                  Background="{DynamicResource ThemeControlLowBrush}"
                  ColumnDefinitions="100,65,105,85,135,140,*">
                  <TextBlock Text="Subnet" Margin="7,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="Type" Margin="7,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="IED" Margin="7,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="3" Text="AP" Margin="7,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="4" Text="IP address" Margin="7,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="5" Text="Subnet mask" Margin="7,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="6" Text="Gateway" Margin="7,5" FontWeight="SemiBold" />
                </Grid>
                <ListBox
                  Grid.Row="1"
                  ItemsSource="{Binding NetworkWorkspaceRows}"
                  SelectedItem="{Binding SelectedNetworkWorkspaceRow, Mode=TwoWay}"
                  BorderThickness="0">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="nav:SclNetworkWorkspaceProjection">
                      <Grid ColumnDefinitions="100,65,105,85,135,140,*" Height="28">
                        <TextBlock Text="{Binding SubNetwork}" Margin="7,4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding NetworkType}" Margin="7,4" />
                        <TextBlock Grid.Column="2" Text="{Binding IedName}" Margin="7,4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding AccessPoint}" Margin="7,4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{Binding IpAddress}" Margin="7,4" />
                        <TextBlock Grid.Column="5" Text="{Binding SubnetMask}" Margin="7,4" />
                        <TextBlock Grid.Column="6" Text="{Binding Gateway}" Margin="7,4" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>

            <TabItem Header="{Binding GooseWorkspaceHeader}">
              <Grid RowDefinitions="29,*,5,185,105">
                <Grid
                  Background="{DynamicResource ThemeControlLowBrush}"
                  ColumnDefinitions="62,115,70,115,145,70,70,*">
                  <TextBlock Text="Type" Margin="6,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="Control" Margin="6,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="LD" Margin="6,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="3" Text="DataSet" Margin="6,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="4" Text="Destination MAC" Margin="6,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="5" Text="APPID" Margin="6,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="6" Text="VLAN" Margin="6,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="7" Text="Subscribers" Margin="6,5" FontWeight="SemiBold" />
                </Grid>

                <ListBox
                  Grid.Row="1"
                  ItemsSource="{Binding GooseWorkspaceRows}"
                  SelectedItem="{Binding SelectedGooseWorkspace, Mode=TwoWay}"
                  BorderThickness="0">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="nav:SclGooseWorkspaceProjection">
                      <Grid ColumnDefinitions="62,115,70,115,145,70,70,*" Height="28">
                        <TextBlock Text="{Binding ServiceType}" Margin="6,4" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   Margin="6,4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding LogicalDevice}"
                                   Margin="6,4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding DataSet}"
                                   Margin="6,4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4"
                                   Text="{Binding MacAddress}"
                                   Margin="6,4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="5"
                                   Text="{Binding NetworkAppId}"
                                   Margin="6,4" />
                        <TextBlock Grid.Column="6"
                                   Text="{Binding VlanId}"
                                   Margin="6,4" />
                        <TextBlock Grid.Column="7"
                                   Text="{Binding SubscriberIedCount}"
                                   Margin="6,4"
                                   HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter
                  Grid.Row="2"
                  Height="5"
                  ResizeDirection="Rows" />

                <Grid Grid.Row="3" ColumnDefinitions="*,5,*">
                  <Grid Grid.Column="0" RowDefinitions="29,*">
                    <Grid
                      Background="{DynamicResource ThemeControlLowBrush}"
                      ColumnDefinitions="*,52,64">
                      <TextBlock Text="Published signal" Margin="6,5" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="FC" Margin="6,5" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="Subs" Margin="6,5" FontWeight="SemiBold" />
                    </Grid>

                    <ListBox
                      Grid.Row="1"
                      ItemsSource="{Binding GooseSignalRows}"
                      SelectedItem="{Binding SelectedGooseSignal, Mode=TwoWay}"
                      BorderThickness="0">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="nav:SclGooseSignalProjection">
                          <Grid ColumnDefinitions="*,52,64" Height="27">
                            <TextBlock Text="{Binding Reference}"
                                       Margin="6,4"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FunctionalConstraint}"
                                       Margin="6,4" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SubscriberCount}"
                                       Margin="6,4"
                                       HorizontalAlignment="Right" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>

                  <GridSplitter
                    Grid.Column="1"
                    Width="5"
                    ResizeDirection="Columns" />

                  <Grid Grid.Column="2" RowDefinitions="29,*">
                    <Grid
                      Background="{DynamicResource ThemeControlLowBrush}"
                      ColumnDefinitions="85,70,85,120,*">
                      <TextBlock Text="Subscriber" Margin="6,5" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="LD" Margin="6,5" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="LN" Margin="6,5" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="3" Text="Internal address" Margin="6,5" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="4" Text="Source" Margin="6,5" FontWeight="SemiBold" />
                    </Grid>

                    <ListBox
                      Grid.Row="1"
                      ItemsSource="{Binding GooseSubscriberRows}"
                      SelectedItem="{Binding SelectedGooseSubscriber, Mode=TwoWay}"
                      BorderThickness="0">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="nav:SclGooseSubscriberProjection">
                          <Grid ColumnDefinitions="85,70,85,120,*" Height="27">
                            <TextBlock Text="{Binding SubscriberIed}"
                                       Margin="6,4"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SubscriberLogicalDevice}"
                                       Margin="6,4"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SubscriberLogicalNode}"
                                       Margin="6,4"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding InternalAddress}"
                                       Margin="6,4"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding SourceReference}"
                                       Margin="6,4"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Grid>

                <Border
                  Grid.Row="4"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="9,7">
                  <Grid
                    ColumnDefinitions="100,*,85,*,75,*,75,*"
                    RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="Control appID" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedGooseWorkspace.ControlAppId}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="ConfRev" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding SelectedGooseWorkspace.ConfigurationRevision}" />
                    <TextBlock Grid.Column="4" Text="AP" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5"
                               Text="{Binding SelectedGooseWorkspace.AccessPoint}" />
                    <TextBlock Grid.Column="6" Text="Endpoint" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="7"
                               Text="{Binding SelectedGooseWorkspace.EndpointStatus}" />

                    <TextBlock Grid.Row="1" Text="MAC" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding SelectedGooseWorkspace.MacAddress}"
                               Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="APPID" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="3"
                               Text="{Binding SelectedGooseWorkspace.NetworkAppId}"
                               Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="4"
                               Text="VLAN" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="5"
                               Text="{Binding SelectedGooseWorkspace.VlanId}"
                               Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="6"
                               Text="Priority" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="7"
                               Text="{Binding SelectedGooseWorkspace.VlanPriority}"
                               Margin="0,7,0,0" />

                    <TextBlock Grid.Row="2" Text="Min / Max time" Margin="0,7,0,0" />
                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,7,0,0">
                      <TextBlock Text="{Binding SelectedGooseWorkspace.MinTime}" />
                      <TextBlock Text="/" Opacity="0.55" />
                      <TextBlock Text="{Binding SelectedGooseWorkspace.MaxTime}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Text="Members"
                               Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="3"
                               Text="{Binding SelectedGooseWorkspace.MemberCount}"
                               Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="4"
                               Text="ExtRefs"
                               Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="5"
                               Text="{Binding SelectedGooseWorkspace.SubscriberCount}"
                               Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="6"
                               Text="IEDs"
                               Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="7"
                               Text="{Binding SelectedGooseWorkspace.SubscriberIedCount}"
                               Margin="0,7,0,0" />
                  </Grid>
                </Border>
              </Grid>
            </TabItem>

            <TabItem Header="{Binding DataSetWorkspaceHeader}">
              <Grid ColumnDefinitions="310,5,*">
                <Grid Grid.Column="0" RowDefinitions="29,*">
                  <Grid
                    Background="{DynamicResource ThemeControlLowBrush}"
                    ColumnDefinitions="75,75,*,48,48">
                    <TextBlock Text="LD" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="LN" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="DataSet" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Members" Margin="3,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Used" Margin="3,5" FontWeight="SemiBold" />
                  </Grid>
                  <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding DataSetWorkspaceRows}"
                    SelectedItem="{Binding SelectedDataSetWorkspace, Mode=TwoWay}"
                    BorderThickness="0">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="nav:SclDataSetWorkspaceProjection">
                        <Grid ColumnDefinitions="75,75,*,48,48" Height="28">
                          <TextBlock Text="{Binding LogicalDevice}" Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding LogicalNode}" Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3" Text="{Binding MemberCount}" Margin="3,4"
                                     HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="4" Text="{Binding UsedByCount}" Margin="3,4"
                                     HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>

                <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" />

                <Grid Grid.Column="2" RowDefinitions="29,*">
                  <Grid
                    Background="{DynamicResource ThemeControlLowBrush}"
                    ColumnDefinitions="80,100,110,95,55,*">
                    <TextBlock Text="LD" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="LN" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Data Object" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Attribute" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="FC" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Reference" Margin="6,5" FontWeight="SemiBold" />
                  </Grid>
                  <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding DataSetMemberRows}"
                    SelectedItem="{Binding SelectedDataSetMember, Mode=TwoWay}"
                    BorderThickness="0">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="nav:SclDataSetMemberProjection">
                        <Grid ColumnDefinitions="80,100,110,95,55,*" Height="28">
                          <TextBlock Text="{Binding LogicalDevice}" Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding LogicalNode}" Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding DataObject}" Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3" Text="{Binding DataAttribute}" Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="4" Text="{Binding FunctionalConstraint}" Margin="6,4" />
                          <TextBlock Grid.Column="5" Text="{Binding Reference}" Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Grid>
            </TabItem>

            <TabItem Header="{Binding ReportWorkspaceHeader}">
              <Grid RowDefinitions="29,*,125">
                <Grid
                  Background="{DynamicResource ThemeControlLowBrush}"
                  ColumnDefinitions="58,125,125,70,*,*">
                  <TextBlock Text="Type" Margin="6,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="Name" Margin="6,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="DataSet" Margin="6,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="3" Text="ConfRev" Margin="6,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="4" Text="Triggers" Margin="6,5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="5" Text="Optional fields" Margin="6,5" FontWeight="SemiBold" />
                </Grid>
                <ListBox
                  Grid.Row="1"
                  ItemsSource="{Binding ReportWorkspaceRows}"
                  SelectedItem="{Binding SelectedReportWorkspace, Mode=TwoWay}"
                  BorderThickness="0">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="nav:SclReportWorkspaceProjection">
                      <Grid ColumnDefinitions="58,125,125,70,*,*" Height="28">
                        <TextBlock Text="{Binding Kind}" Margin="6,4" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="6,4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding DataSet}" Margin="6,4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding ConfigurationRevision}" Margin="6,4" />
                        <TextBlock Grid.Column="4" Text="{Binding TriggerSummary}" Margin="6,4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="5" Text="{Binding OptionalFieldsSummary}" Margin="6,4"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <Border
                  Grid.Row="2"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="10,7">
                  <Grid ColumnDefinitions="115,*,100,*,95,*"
                        RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="Report ID" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedReportWorkspace.ReportId}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="LD / LN" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding SelectedReportWorkspace.LogicalDevice}" />
                    <TextBlock Grid.Column="4" Text="Max clients" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5"
                               Text="{Binding SelectedReportWorkspace.MaxClients}" />

                    <TextBlock Grid.Row="1" Text="Buffer time" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding SelectedReportWorkspace.BufferTime}"
                               Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="Integrity period" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="3"
                               Text="{Binding SelectedReportWorkspace.IntegrityPeriod}"
                               Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="4"
                               Text="DataSet" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="5"
                               Text="{Binding SelectedReportWorkspace.DataSet}"
                               Margin="0,7,0,0" />

                    <TextBlock Grid.Row="2" Text="Triggers" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                               Text="{Binding SelectedReportWorkspace.TriggerSummary}"
                               Margin="0,7,8,0" />
                    <TextBlock Grid.Row="2" Grid.Column="3"
                               Text="Optional fields" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2"
                               Text="{Binding SelectedReportWorkspace.OptionalFieldsSummary}"
                               Margin="0,7,0,0"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </Grid>
            </TabItem>
            <TabItem Header="{Binding DataModelWorkspaceHeader}">
              <Grid ColumnDefinitions="265,5,*">
                <Grid Grid.Column="0" RowDefinitions="29,*">
                  <Grid
                    Background="{DynamicResource ThemeControlLowBrush}"
                    ColumnDefinitions="70,80,55,45,*">
                    <TextBlock Text="LD" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="LN" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Class" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="DO" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Description" Margin="6,5" FontWeight="SemiBold" />
                  </Grid>

                  <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding DataModelLogicalNodes}"
                    SelectedItem="{Binding SelectedDataModelLogicalNode, Mode=TwoWay}"
                    BorderThickness="0">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="nav:SclDataModelLogicalNodeProjection">
                        <Grid ColumnDefinitions="70,80,55,45,*" Height="28">
                          <TextBlock Text="{Binding LogicalDevice}"
                                     Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding LogicalNode}"
                                     Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding LnClass}"
                                     Margin="6,4" />
                          <TextBlock Grid.Column="3"
                                     Text="{Binding DataObjectCount}"
                                     Margin="6,4"
                                     HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="4"
                                     Text="{Binding Description}"
                                     Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>

                <GridSplitter
                  Grid.Column="1"
                  Width="5"
                  ResizeDirection="Columns" />

                <Grid Grid.Column="2" RowDefinitions="29,*,90">
                  <Grid
                    Background="{DynamicResource ThemeControlLowBrush}"
                    ColumnDefinitions="*,52,55,48,90,145,*">
                    <TextBlock Text="Name" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Kind" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="CDC" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="FC" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="bType" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Value" Margin="6,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="Description" Margin="6,5" FontWeight="SemiBold" />
                  </Grid>

                  <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding DataModelRows}"
                    SelectedItem="{Binding SelectedDataModelRow, Mode=TwoWay}"
                    BorderThickness="0">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="nav:SclDataModelRowProjection">
                        <Grid ColumnDefinitions="*,52,55,48,90,145,*" Height="27">
                          <TextBlock Text="{Binding DisplayName}"
                                     Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding Kind}"
                                     Margin="6,4" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Cdc}"
                                     Margin="6,4" />
                          <TextBlock Grid.Column="3"
                                     Text="{Binding FunctionalConstraint}"
                                     Margin="6,4" />
                          <TextBlock Grid.Column="4"
                                     Text="{Binding BasicType}"
                                     Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="5"
                                     Text="{Binding Value}"
                                     Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="6"
                                     Text="{Binding Description}"
                                     Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <Border
                    Grid.Row="2"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="9,7">
                    <Grid
                      ColumnDefinitions="100,*,75,*,90,*"
                      RowDefinitions="Auto,Auto">
                      <TextBlock Text="LN type" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding SelectedDataModelLogicalNode.LnType}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2"
                                 Text="Object path"
                                 FontWeight="SemiBold" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding SelectedDataModelRow.Path}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="4"
                                 Text="Type ID"
                                 FontWeight="SemiBold" />
                      <TextBlock Grid.Column="5"
                                 Text="{Binding SelectedDataModelRow.TypeId}"
                                 TextTrimming="CharacterEllipsis" />

                      <TextBlock Grid.Row="1"
                                 Text="Selected LN"
                                 Margin="0,7,0,0" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding SelectedDataModelLogicalNode.LogicalNode}"
                                 Margin="0,7,0,0" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="2"
                                 Text="Value"
                                 Margin="0,7,0,0" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="3"
                                 Text="{Binding SelectedDataModelRow.Value}"
                                 Margin="0,7,0,0"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="4"
                                 Text="Description"
                                 Margin="0,7,0,0" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="5"
                                 Text="{Binding SelectedDataModelRow.Description}"
                                 Margin="0,7,0,0"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </TabItem>

            <TabItem Header="{Binding SettingGroupsWorkspaceHeader}">
              <Grid ColumnDefinitions="225,5,*">
                <Grid Grid.Column="0" RowDefinitions="29,*">
                  <Grid
                    Background="{DynamicResource ThemeControlLowBrush}"
                    ColumnDefinitions="*,62,58">
                    <TextBlock Text="Logical device"
                               Margin="6,5"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="Groups"
                               Margin="6,5"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2"
                               Text="Active"
                               Margin="6,5"
                               FontWeight="SemiBold" />
                  </Grid>

                  <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding SettingGroupControls}"
                    SelectedItem="{Binding SelectedSettingGroupControl, Mode=TwoWay}"
                    BorderThickness="0">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="nav:SclSettingGroupControlProjection">
                        <Grid ColumnDefinitions="*,62,58" Height="28">
                          <TextBlock Text="{Binding LogicalDevice}"
                                     Margin="6,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding NumberOfGroups}"
                                     Margin="6,4"
                                     HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding ActiveGroup}"
                                     Margin="6,4"
                                     HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>

                <GridSplitter
                  Grid.Column="1"
                  Width="5"
                  ResizeDirection="Columns" />

                <Grid Grid.Column="2" RowDefinitions="29,*,82">
                  <Grid
                    Background="{DynamicResource ThemeControlLowBrush}"
                    ColumnDefinitions="90,110,120,95,55,72,72,65,85,*">
                    <TextBlock Text="LN" Margin="5,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Data Object" Margin="5,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Setting" Margin="5,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Value" Margin="5,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Unit" Margin="5,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Min" Margin="5,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="Max" Margin="5,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="7" Text="Step" Margin="5,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="8" Text="Type" Margin="5,5" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="9" Text="Description" Margin="5,5" FontWeight="SemiBold" />
                  </Grid>

                  <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding SettingGroupSettings}"
                    SelectedItem="{Binding SelectedSettingGroupSetting, Mode=TwoWay}"
                    BorderThickness="0">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="nav:SclSettingGroupSettingProjection">
                        <Grid ColumnDefinitions="90,110,120,95,55,72,72,65,85,*" Height="27">
                          <TextBlock Text="{Binding LogicalNode}"
                                     Margin="5,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding DataObject}"
                                     Margin="5,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Setting}"
                                     Margin="5,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3"
                                     Text="{Binding Value}"
                                     Margin="5,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="4"
                                     Text="{Binding Unit}"
                                     Margin="5,4" />
                          <TextBlock Grid.Column="5"
                                     Text="{Binding Minimum}"
                                     Margin="5,4" />
                          <TextBlock Grid.Column="6"
                                     Text="{Binding Maximum}"
                                     Margin="5,4" />
                          <TextBlock Grid.Column="7"
                                     Text="{Binding Step}"
                                     Margin="5,4" />
                          <TextBlock Grid.Column="8"
                                     Text="{Binding BasicType}"
                                     Margin="5,4"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="9"
                                     Text="{Binding Description}"
                                     Margin="5,4"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <Border
                    Grid.Row="2"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="9,7">
                    <Grid
                      ColumnDefinitions="95,*,80,*,95,*"
                      RowDefinitions="Auto,Auto">
                      <TextBlock Text="Logical device" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding SelectedSettingGroupControl.LogicalDevice}" />
                      <TextBlock Grid.Column="2"
                                 Text="Active group"
                                 FontWeight="SemiBold" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding SelectedSettingGroupControl.ActiveGroup}" />
                      <TextBlock Grid.Column="4"
                                 Text="Groups"
                                 FontWeight="SemiBold" />
                      <TextBlock Grid.Column="5"
                                 Text="{Binding SelectedSettingGroupControl.NumberOfGroups}" />

                      <TextBlock Grid.Row="1"
                                 Text="Edit group"
                                 Margin="0,7,0,0" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding SelectedSettingGroupControl.EditGroup}"
                                 Margin="0,7,0,0" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="2"
                                 Text="Confirm edit"
                                 Margin="0,7,0,0" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="3"
                                 Text="{Binding SelectedSettingGroupControl.Confirmation}"
                                 Margin="0,7,0,0" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="4"
                                 Text="Reservation"
                                 Margin="0,7,0,0" />
                      <TextBlock Grid.Row="1"
                                 Grid.Column="5"
                                 Text="{Binding SelectedSettingGroupControl.ReservationTime}"
                                 Margin="0,7,0,0" />
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </TabItem>

          </TabControl>

          <Border
            Grid.Row="2"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="8,5">
            <TextBlock
              Text="Engineering workspaces are projected from the authoritative SCL model. XML remains available as expert/source view."
              Opacity="0.58"
              TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>

      <GridSplitter
        Grid.Column="3"
        Width="5"
        ResizeDirection="Columns" />

      <Border Grid.Column="4" Classes="panel">
        <TabControl>
          <TabItem Header="Context">
            <ScrollViewer>
              <StackPanel Margin="14" Spacing="10">
                <TextBlock
                  Text="{Binding DetailTitle}"
                  FontSize="16"
                  FontWeight="SemiBold" />
                <TextBlock Text="{Binding DetailKind}" Opacity="0.68" />

                <Border
                  Background="{DynamicResource ThemeControlLowBrush}"
                  Padding="10"
                  CornerRadius="4">
                  <TextBlock
                    Text="{Binding DetailDescription}"
                    TextWrapping="Wrap" />
                </Border>

                <TextBlock
                  Text="Semantic path"
                  FontWeight="SemiBold"
                  Margin="0,8,0,0" />
                <TextBlock
                  Text="{Binding DetailPath}"
                  TextWrapping="Wrap" />

                <TextBlock
                  Text="Source"
                  FontWeight="SemiBold"
                  Margin="0,8,0,0" />
                <TextBlock
                  Text="{Binding DetailSource}"
                  TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="{Binding WhereUsedHeader}">
            <ListBox
              ItemsSource="{Binding WhereUsedRows}"
              SelectedItem="{Binding SelectedWhereUsedRow, Mode=TwoWay}"
              BorderThickness="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="nav:SclReferenceProjection">
                  <Grid
                    RowDefinitions="Auto,Auto"
                    Margin="8,5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock
                        Text="{Binding SourceLabel}"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                      <TextBlock
                        Grid.Column="1"
                        Text="{Binding Kind}"
                        Opacity="0.58"
                        Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock
                      Grid.Row="1"
                      Text="{Binding ReferenceText}"
                      Opacity="0.68"
                      TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <Border
      Grid.Row="4"
      Classes="panel"
      Margin="8,5,8,0">
      <TabControl>
        <TabItem Header="Problems">
          <Grid RowDefinitions="30,*">
            <Grid
              ColumnDefinitions="85,105,105,120,*,150"
              Background="{DynamicResource ThemeControlLowBrush}">
              <TextBlock Text="Severity" Margin="8,6" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="Code" Margin="8,6" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="Domain" Margin="8,6" FontWeight="SemiBold" />
              <TextBlock Grid.Column="3" Text="Object" Margin="8,6" FontWeight="SemiBold" />
              <TextBlock Grid.Column="4" Text="Message" Margin="8,6" FontWeight="SemiBold" />
              <TextBlock Grid.Column="5" Text="Source" Margin="8,6" FontWeight="SemiBold" />
            </Grid>

            <ListBox
              Grid.Row="1"
              ItemsSource="{Binding Problems}"
              SelectedItem="{Binding SelectedProblemRow, Mode=TwoWay}"
              BorderThickness="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProblemRow">
                  <Grid
                    ColumnDefinitions="85,105,105,120,*,150"
                    Height="28">
                    <TextBlock Text="{Binding Severity}" Margin="8,4" />
                    <TextBlock Grid.Column="1" Text="{Binding Code}" Margin="8,4" />
                    <TextBlock Grid.Column="2" Text="{Binding Domain}" Margin="8,4" />
                    <TextBlock Grid.Column="3" Text="{Binding ObjectName}" Margin="8,4" />
                    <TextBlock
                      Grid.Column="4"
                      Text="{Binding Message}"
                      ToolTip.Tip="{Binding Explanation}"
                      Margin="8,4"
                      TextTrimming="CharacterEllipsis" />
                    <TextBlock
                      Grid.Column="5"
                      Text="{Binding Source}"
                      Margin="8,4"
                      TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <TabItem Header="{Binding SearchResultsHeader}">
          <Grid RowDefinitions="30,*">
            <Grid
              ColumnDefinitions="150,180,*"
              Background="{DynamicResource ThemeControlLowBrush}">
              <TextBlock Text="Kind" Margin="8,6" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="Name" Margin="8,6" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="Path" Margin="8,6" FontWeight="SemiBold" />
            </Grid>

            <ListBox
              Grid.Row="1"
              ItemsSource="{Binding SearchResults}"
              SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
              BorderThickness="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="search:SclSearchResultProjection">
                  <Grid
                    ColumnDefinitions="150,180,*"
                    Height="28">
                    <TextBlock Text="{Binding Kind}" Margin="8,4" />
                    <TextBlock
                      Grid.Column="1"
                      Text="{Binding Name}"
                      Margin="8,4"
                      TextTrimming="CharacterEllipsis" />
                    <TextBlock
                      Grid.Column="2"
                      Text="{Binding Path}"
                      Margin="8,4"
                      TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <TabItem Header="Changes">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,4">
              <Button Content="Undo" Click="UndoClick" IsEnabled="{Binding CanUndo}" />
              <Button Content="Redo" Click="RedoClick" IsEnabled="{Binding CanRedo}" />
              <TextBlock Text="Recent property changes (bounded history)" VerticalAlignment="Center" Opacity="0.65" />
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding ChangeRows}">
              <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ChangeRow">
                  <Grid ColumnDefinitions="65,65,90,*,*" Height="28">
                    <TextBlock Text="{Binding Revision}" Margin="8,4" />
                    <TextBlock Grid.Column="1" Text="{Binding Action}" Margin="8,4" />
                    <TextBlock Grid.Column="2" Text="{Binding Target}" Margin="8,4" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Before}" Margin="8,4" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding After}" Margin="8,4" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>
        <TabItem Header="Signal Basket" IsEnabled="False" />
        <TabItem Header="Diff" IsEnabled="False" />
        <TabItem Header="Output" IsEnabled="False" />
      </TabControl>
    </Border>

    <Border
      Grid.Row="5"
      Padding="8,5"
      BorderBrush="{DynamicResource ThemeBorderLowBrush}"
      BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" />
        <StackPanel
          Grid.Column="1"
          Orientation="Horizontal"
          Spacing="14">
          <TextBlock Text="{Binding DocumentDisplayName}" />
          <TextBlock Text="{Binding DocumentKind}" />
          <TextBlock Text="{Binding SaveStateText}" />
          <TextBlock Text="Offline" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

